# Copy this file to .env and fill in real values. .env is git-ignored.

# --- App ---
APP_NAME=Shiv Paneer Shawarma
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# --- Google Cloud Datastore / NDB ---
# Any project id works with the local emulator.
GCP_PROJECT_ID=shiv-paneer-shawarma
# Named Datastore database. Leave empty to use the "(default)" database.
# Production uses a non-default database (e.g. spsndb); set it here in prod.
DATASTORE_DATABASE=
# When set, the app talks to the local Datastore emulator instead of live Datastore.
# Start the emulator with:  gcloud beta emulators datastore start --project=shiv-paneer-shawarma
DATASTORE_EMULATOR_HOST=localhost:8081
# For PRODUCTION leave DATASTORE_EMULATOR_HOST empty and point this at a service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Auth (JWT) ---
# Generate a strong secret for production:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Cookie flags. In production over HTTPS set COOKIE_SECURE=true.
COOKIE_NAME=sps_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- User provisioning ---
# Secret key that gates the standalone user-creation page (frontend/provision.html).
# Sent by that page as the X-Setup-Key header. Empty = provisioning disabled.
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
SETUP_KEY=change-this-setup-key

# --- Default seed users (created by seed.py) ---
OWNER_EMAIL=owner@shivpaneer.com
OWNER_PASSWORD=owner123
STAFF_EMAIL=staff@shivpaneer.com
STAFF_PASSWORD=staff123

# --- Ordering / payments ---
# Delivery fee in INR applied to delivery orders (owner can refine later).
DELIVERY_FEE=40
# Restaurant UPI *merchant* (P2M) identity used to build the payment QR.
# Decode your GPay-for-Business QR to get these. The merchant fields (MC/AID/MODE)
# are required — a bare pa+am link to a merchant VPA is rejected by UPI apps.
UPI_VPA=9429271514-2@okbizaxis
UPI_PAYEE_NAME=Shiv Paneer Shawarma
UPI_PAYEE_VPA_NAME=VIRALKUMAR
UPI_MERCHANT_CODE=5812
UPI_MERCHANT_AID=uGICAgMDS4_a_XQ
UPI_QR_VER=01
UPI_QR_MODE=01
UPI_TXN_REF=BCR2DN4T5LE5JELG

# --- Google Maps ---
# Google Maps Platform JS + Places API key. Placeholder until provided.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
